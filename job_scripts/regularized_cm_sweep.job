#!/bin/bash
#SBATCH --job-name=reg_cm_sweep
#SBATCH --partition=cpu-zen4
#SBATCH --time=7-00:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=8G
#SBATCH --array=0-35
#SBATCH --output=slurm_logs/reg_cm_%A_%a.out
#SBATCH --error=slurm_logs/reg_cm_%A_%a.err

# Regularized-CM LER + latency sweep. CPU-ONLY (PyMatching); no GPU. ONE array task per
# (distance, p) pair; within a task, --n-workers seed-split processes (= cpus-per-task)
# parallelise the sampling with CRN preserved. Each task writes its OWN CSV (no
# collisions); concatenate afterwards (they share a header):
#   awk 'FNR==1 && NR!=1{next} {print}' data/reg_cm_sweep/reg_cm_*.csv > data/reg_cm_sweep_all.csv
#
# DEPENDS ON reg_cm_alpha_scan: the 4 tested alphas are chosen from the scan's best alpha
# per (d,p) (data/reg_cm_alpha_scan/*.csv). Run the scan job first, or submit this with
#   sbatch --dependency=afterok:<scan_jobid> job_scripts/regularized_cm_sweep.job
# (d=9 has no scan and falls back to the d=7 scan automatically.)
# The deepest low-p d=7/d=9 points won't reach --target-errors even in 7 days -> give them
# more cores (raise --cpus-per-task/--n-workers) or a dedicated higher-core submission.

set -euo pipefail
echo "Job started at: $(date)"

module load Python/3.11.5-GCCcore-13.2.0
source new_cluster_venv/bin/activate         # <- adjust if your venv has a different name/path

# one worker process per core; keep each worker single-threaded (no BLAS oversubscription)
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

mkdir -p slurm_logs data/reg_cm_sweep

# --- axes: the array index selects one (distance, p) pair ----------------------
DISTANCES=(3 5 7 9)
P_VALUES=(1e-2 7e-3 4e-3 2e-3 1e-3 7e-4 4e-4 2e-4 1e-4)
NP=${#P_VALUES[@]}                                   # keep --array=0-(len(D)*NP-1)  (4*9-1 = 35)

D=${DISTANCES[$(( SLURM_ARRAY_TASK_ID / NP ))]}
P=${P_VALUES[$(( SLURM_ARRAY_TASK_ID % NP ))]}

OUT_CSV="data/reg_cm_sweep/reg_cm_d${D}_p${P}_${SLURM_ARRAY_JOB_ID}.csv"

# Stop ~1h before the 7-day (604800s) walltime so the incremental CSV is flushed and
# the task exits gracefully instead of being killed mid-write. The deepest low-p d=7
# points won't reach --target-errors even in 7 days -> seed-split those (see chat/README).
MAX_SECONDS=601200

ARGS=(
  --distances "$D"
  --p-values "$P"
  --rounds 0                 # 0 -> rounds = distance
  --target-errors 1000       # the BEST alpha must reach this many logical errors
  --chunk 1000000
  --max-shots 20000000000
  --max-seconds "$MAX_SECONDS"
  --seed 12345
  --n-workers "$SLURM_CPUS_PER_TASK"   # seed-split across the task's cores (CRN preserved)
  # 4 damped alphas chosen from the reg_cm_alpha_scan best alpha for this (d,p):
  --scan-csv "data/reg_cm_alpha_scan/*.csv,data/reg_cm_alpha_scan_*.csv"
  --out-csv "$OUT_CSV"
)

echo "Array task ${SLURM_ARRAY_TASK_ID}: distance=${D}, p=${P}"
echo "Output CSV: ${OUT_CSV}"
echo "Command: python -u scripts/regularized_cm_sweep.py ${ARGS[*]}"

python -u scripts/regularized_cm_sweep.py "${ARGS[@]}"

echo "Job finished at: $(date)"
